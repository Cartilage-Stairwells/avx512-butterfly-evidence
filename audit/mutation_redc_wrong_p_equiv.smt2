(define-fun mp_0 () (_ BitVec 64) (bvadd prod_0 (bvmul ((_ zero_extend 32) m_0) ((_ zero_extend 32) #x78000001))))
(define-fun t_0 () (_ BitVec 32) ((_ extract 63 32) mp_0))
(define-fun ge_0 () Bool (bvuge t_0 #x78000001))
(define-fun out_0 () (_ BitVec 32) (bvsub t_0 (ite ge_0 #x78000001 #x00000000)))
(define-fun mp2_0 () (_ BitVec 64) (bvadd prod_0 (bvmul ((_ zero_extend 32) m_0) ((_ zero_extend 32) #x78000002))))
