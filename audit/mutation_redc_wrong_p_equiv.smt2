; this implies mutation_redc_wrong_p.smt2 must also answer unsat: identical
; schedules satisfy identical claims. Negated conjunction; expect unsat.
(set-option :produce-models true)
(set-logic QF_BV)
(declare-const a0 (_ BitVec 32))
(declare-const b0 (_ BitVec 32))
(assert (bvult a0 #x78000001))
(assert (bvult b0 #x78000001))
(define-fun prod_0 () (_ BitVec 64) (bvmul ((_ zero_extend 32) a0) ((_ zero_extend 32) b0)))
