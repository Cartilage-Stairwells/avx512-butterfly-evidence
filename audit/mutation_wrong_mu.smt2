(set-option :produce-models true)
(set-logic QF_BV)
; Subtraction-form REDC. Correct equation:
;   res*R = T - q*P + (underflow ? P*R : 0)
; rearranged: T + (underflow ? P*R : 0) = res*R + q*P
; All non-negative, no wrapping (sums < 2^64).
(define-sort BitVec64 () (_ BitVec 64))
(declare-const tw BitVec64)
(declare-const b BitVec64)
(define-fun P () BitVec64 #x0000000078000001)
(define-fun MU () BitVec64 #x0000000077ffffff)
(define-fun R () BitVec64 #x0000000100000000)
(define-fun PR () BitVec64 #x7800000100000000)
(define-fun MASK32 () BitVec64 #x00000000ffffffff)
(assert (bvult tw P))
(assert (bvult b P))
(define-fun T () BitVec64 (bvmul tw b))
(define-fun lo () BitVec64 (bvand T MASK32))
(define-fun q () BitVec64 (bvand (bvmul lo MU) MASK32))
(define-fun q_p () BitVec64 (bvmul q P))
(define-fun prod_hi () BitVec64 (bvlshr T #x0000000000000020))
(define-fun q_p_hi () BitVec64 (bvlshr q_p #x0000000000000020))
(define-fun underflow () Bool (bvult prod_hi q_p_hi))
(define-fun res () BitVec64 (ite underflow (bvadd (bvsub prod_hi q_p_hi) P) (bvsub prod_hi q_p_hi)))
(assert (not (and (bvult res P)
                  (= (bvadd T (ite underflow PR #x0000000000000000))
                     (bvadd (bvmul res R) (bvmul q P))))))
(check-sat)
(exit)
